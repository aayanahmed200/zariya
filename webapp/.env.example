# Local Flask development defaults to your Ollama app at localhost:11434.
# Vercel defaults to https://ollama.com (Ollama Cloud).

# Ollama Cloud (required on Vercel for generative chat).
# Create a key at https://ollama.com/settings/keys and add it to Vercel
# Project Settings -> Environment Variables. Never commit the actual key.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Local development can use the downloaded models on your computer:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# If using your own remote Ollama server instead of Ollama Cloud, set its
# HTTPS base URL here and protect it with OLLAMA_API_KEY.
# OLLAMA_BASE_URL=https://your-private-ollama-host.example

# Optional Supabase cloud workspace storage. Run the migration at
# ../supabase/migrations/202611220001_create_zariya_workspaces.sql first.
# Keep the secret server-side; never use a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for server-side workspace syncing. Keep this key private.
SUPABASE_SECRET_KEY=
# Legacy alternative if the project still uses a service-role JWT:
# SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Custom Search (for the Search web tool).
GOOGLE_API_KEY=
GOOGLE_CX=

# Optional GitHub profile sign-in.
FLASK_SECRET_KEY=
APP_BASE_URL=http://localhost:5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
