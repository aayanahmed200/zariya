# Copy this file to .env for local Flask development.
# The browser app works without optional provider credentials.

# Flask session signing key. Use a private random string of at least 32 characters.
FLASK_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Public base URL for GitHub OAuth callbacks.
APP_BASE_URL=http://localhost:5000

# Optional generative chat provider. Prompts are sent to Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional Google Custom Search provider.
GOOGLE_API_KEY=
GOOGLE_CX=

# Optional GitHub profile sign-in.
# OAuth callback: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local-only Ollama settings. Vercel disables Ollama automatically.
# LOCAL_MODEL_NAME=qwen2.5:1.5b
# OLLAMA_URL=http://localhost:11434
# DISABLE_LOCAL_MODEL=1
